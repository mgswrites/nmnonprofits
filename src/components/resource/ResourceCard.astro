---
import type { ResourceCard } from '../../lib/types';

interface Props {
  resource: ResourceCard;
}

const { resource } = Astro.props;

const TYPE_LABELS: Record<string, string> = {
  guide:     'Guide',
  template:  'Template',
  tool:      'Tool',
  database:  'Database',
  directory: 'Directory',
  training:  'Training',
  video:     'Video',
  podcast:   'Podcast',
  book:      'Book',
};

const TYPE_COLORS: Record<string, string> = {
  guide:     'bg-turquoise-100 text-turquoise-800',
  template:  'bg-blue-100 text-blue-800',
  tool:      'bg-purple-100 text-purple-800',
  database:  'bg-zia-100 text-zia-800',
  directory: 'bg-green-100 text-green-800',
  training:  'bg-orange-100 text-orange-800',
  video:     'bg-pink-100 text-pink-800',
  podcast:   'bg-indigo-100 text-indigo-800',
  book:      'bg-amber-100 text-amber-800',
};

const typeLabel = TYPE_LABELS[resource.resource_type ?? ''] ?? resource.resource_type ?? 'Resource';
const typeColor = TYPE_COLORS[resource.resource_type ?? ''] ?? 'bg-gray-100 text-gray-700';
const href = resource.url ?? `/resources/${resource.slug}/`;
const external = !!resource.url;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="card flex flex-col p-5 gap-3 group"
  aria-label={resource.title}
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="font-semibold text-gray-900 group-hover:text-turquoise-700 transition-colors leading-snug text-sm line-clamp-2">
        {resource.title}
      </h3>
      {resource.author_name && (
        <p class="text-xs text-gray-500 mt-0.5">{resource.author_name}</p>
      )}
    </div>
    <div class="flex flex-col items-end gap-1.5 shrink-0">
      <span class={`badge ${typeColor}`}>{typeLabel}</span>
      {resource.is_free && (
        <span class="badge bg-green-50 text-green-700">Free</span>
      )}
    </div>
  </div>

  {resource.description && (
    <p class="text-xs text-gray-500 line-clamp-3 leading-relaxed">
      {resource.description}
    </p>
  )}

  {resource.sectors.length > 0 && (
    <div class="flex flex-wrap gap-1.5 pt-1 border-t border-gray-50 mt-auto">
      {resource.sectors.slice(0, 3).map((s) => (
        <span class="badge bg-gray-100 text-gray-600">{s.name}</span>
      ))}
    </div>
  )}
</a>
