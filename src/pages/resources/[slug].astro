---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getResourceBySlug } from '../../lib/queries';
import { getDb } from '../../lib/db';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/resources/');

const resource = await getResourceBySlug(slug);
if (!resource) return Astro.redirect('/resources/', 302);

const sql = getDb();
const sectorRows = await sql<{ name: string; slug: string }[]>`
  SELECT s.name, s.slug FROM sectors s
  JOIN resource_sectors rs ON rs.sector_id = s.id
  WHERE rs.resource_id = ${resource.id}
  ORDER BY s.name
`;

const TYPE_LABELS: Record<string, string> = {
  guide:     'Guide',
  template:  'Template',
  tool:      'Tool',
  database:  'Database',
  directory: 'Directory',
  training:  'Training',
  video:     'Video',
  podcast:   'Podcast',
  book:      'Book',
};

const typeLabel = TYPE_LABELS[resource.resource_type ?? ''] ?? resource.resource_type ?? 'Resource';
---

<Layout
  title={resource.meta_title ?? `${resource.title} | NM Nonprofits Resources`}
  description={resource.meta_description ?? resource.description ?? ''}
>
  <div class="container-content py-10 max-w-3xl">
    <!-- Breadcrumb -->
    <nav class="text-xs text-gray-400 flex gap-1.5 items-center mb-6">
      <a href="/" class="hover:text-gray-600">Home</a>
      <span>/</span>
      <a href="/resources/" class="hover:text-gray-600">Resources</a>
      <span>/</span>
      <span class="text-gray-600 truncate">{resource.title}</span>
    </nav>

    <div class="bg-white border border-gray-200 rounded-xl p-8">
      <!-- Header -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          <span class="badge bg-turquoise-100 text-turquoise-800">{typeLabel}</span>
          {resource.is_free && (
            <span class="badge bg-green-50 text-green-700">Free</span>
          )}
        </div>
        <h1 class="text-2xl font-serif font-bold text-gray-900 mb-1">{resource.title}</h1>
        {resource.author_name && (
          <p class="text-gray-500 text-sm">{resource.author_name}</p>
        )}
      </div>

      <!-- Description -->
      {resource.description && (
        <div class="prose prose-gray max-w-none mb-8">
          {resource.description.split('\n\n').map((p: string) => <p>{p.trim()}</p>)}
        </div>
      )}

      <!-- Issue areas -->
      {sectorRows.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {sectorRows.map(s => (
            <a href={`/nonprofits/${s.slug}/`}
              class="badge bg-gray-100 text-gray-600 hover:bg-turquoise-50 hover:text-turquoise-700 transition-colors">
              {s.name}
            </a>
          ))}
        </div>
      )}

      <!-- CTA -->
      {(resource.url || resource.file_url) && (
        <div class="border-t border-gray-100 pt-6 flex flex-wrap gap-3">
          {resource.url && (
            <a href={resource.url} target="_blank" rel="noopener noreferrer"
              class="btn-primary bg-zia-600 hover:bg-zia-500">
              Visit Resource →
            </a>
          )}
          {resource.file_url && (
            <a href={resource.file_url} target="_blank" rel="noopener noreferrer"
              class="btn-secondary">
              Download
            </a>
          )}
        </div>
      )}
    </div>

    <div class="mt-6">
      <a href="/resources/" class="text-sm text-gray-500 hover:text-turquoise-700">← Back to all resources</a>
    </div>
  </div>
</Layout>
